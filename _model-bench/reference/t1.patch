index 0000000..b23e0ca
--- /dev/null
+++ b/handlers/tracker_behavior_test.go
@@ -0,0 +1,47 @@
+package handlers
+
+import (
+	"errors"
+	"testing"
+
+	"pricetrackerbot/clients"
+	"pricetrackerbot/config"
+)
+
+type fakeClient struct {
+	result *clients.DataResult
+	err    error
+}
+
+func (c *fakeClient) FetchAndExtractData(_ *config.Tracker) (*clients.DataResult, error) {
+	return c.result, c.err
+}
+
+func TestClientTrackerBehavior(t *testing.T) {
+	errFetch := errors.New("fetch failed")
+
+	tests := []struct {
+		name             string
+		client           *fakeClient
+		wantValue        string
+		wantNotification string
+		wantErr          error
+	}{
+		{name: "value rounded to two decimals", client: &fakeClient{result: &clients.DataResult{CurrentValue: 3.14159}}, wantValue: "3.14"},
+		{name: "notification passed through", client: &fakeClient{result: &clients.DataResult{CurrentValue: 2, NotificationMessage: "Good news"}}, wantValue: "2.00", wantNotification: "Good news"},
+		{name: "client error returned", client: &fakeClient{err: errFetch}, wantErr: errFetch},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			value, notification, err := NewClientTrackerBehavior(tt.client).Execute(&config.Tracker{Code: "test"})
+			if !errors.Is(err, tt.wantErr) {
+				t.Fatalf("err = %v, want %v", err, tt.wantErr)
+			}
+
+			if value != tt.wantValue || notification != tt.wantNotification {
+				t.Errorf("Execute = (%q, %q), want (%q, %q)", value, notification, tt.wantValue, tt.wantNotification)
+			}
+		})
+	}
+}
