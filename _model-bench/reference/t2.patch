+
+func TestDuplicateCode(t *testing.T) {
+	tests := []struct {
+		name  string
+		codes []string
+		want  string
+	}{
+		{name: "unique", codes: []string{"a", "b", "c"}},
+		{name: "repeated", codes: []string{"a", "b", "a"}, want: "a"},
+		{name: "empty", codes: nil},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			trackers := make([]*Tracker, 0, len(tt.codes))
+			for _, code := range tt.codes {
+				trackers = append(trackers, &Tracker{Code: code})
+			}
+
+			code, found := duplicateCode(trackers)
+			if found != (tt.want != "") || code != tt.want {
+				t.Errorf("duplicateCode(%v) = %q, %v; want %q", tt.codes, code, found, tt.want)
+			}
+		})
+	}
+}
