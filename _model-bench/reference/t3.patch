diff --git a/handlers/tracker_manager.go b/handlers/tracker_manager.go
new file mode 100644
index 0000000..6d31430
--- /dev/null
+++ b/handlers/tracker_manager.go
@@ -0,0 +1,247 @@
+package handlers
+
+import (
+	"errors"
+	"fmt"
+	"log"
+	"slices"
+	"strings"
+	"sync"
+	"time"
+
+	"pricetrackerbot/config"
+	"pricetrackerbot/helpers"
+)
+
+var (
+	ErrTrackerAlreadyRunning = errors.New("tracker is already running")
+	ErrTrackerNotRunning     = errors.New("tracker is not running")
+	ErrIntervalBelowMinimum  = errors.New("interval is below the minimum")
+)
+
+// TrackerManager owns the running trackers and keeps the state file in sync with them.
+type TrackerManager struct {
+	config    *config.Configuration
+	messenger helpers.Messenger
+
+	// Also held while saving, so that concurrent changes can't overwrite the state file with an older list
+	mu      sync.Mutex
+	running []*Tracker
+}
+
+func NewTrackerManager(messenger helpers.Messenger, config *config.Configuration) *TrackerManager {
+	return &TrackerManager{config: config, messenger: messenger}
+}
+
+// Get returns the running tracker with this code, or nil.
+func (m *TrackerManager) Get(code string) *Tracker {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+
+	return m.find(code)
+}
+
+// Start creates and starts a tracker for the chat with its configured interval.
+func (m *TrackerManager) Start(code string, chatID int64) error {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+
+	if err := m.start(code, 0, chatID, false); err != nil {
+		return err
+	}
+
+	m.save()
+
+	return nil
+}
+
+// StartAll starts every configured tracker that isn't running and returns the errors by tracker code.
+func (m *TrackerManager) StartAll(chatID int64) map[string]error {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+
+	failed := make(map[string]error)
+
+	for _, trackers := range [][]*config.Tracker{m.config.APITrackers, m.config.ScraperTrackers} {
+		for _, tracker := range trackers {
+			if m.find(tracker.Code) != nil {
+				continue
+			}
+
+			if err := m.start(tracker.Code, 0, chatID, false); err != nil {
+				failed[tracker.Code] = err
+			}
+		}
+	}
+
+	m.save()
+
+	return failed
+}
+
+// Stop stops a running tracker. Returns false if it wasn't running.
+func (m *TrackerManager) Stop(code string) bool {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+
+	index := slices.IndexFunc(m.running, func(t *Tracker) bool { return t.Code == code })
+	if index < 0 {
+		return false
+	}
+
+	m.running[index].Stop()
+	m.running = slices.Delete(m.running, index, index+1)
+	m.save()
+
+	return true
+}
+
+func (m *TrackerManager) StopAll() {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+
+	for _, tracker := range m.running {
+		tracker.Stop()
+	}
+
+	m.running = nil
+	m.save()
+}
+
+func (m *TrackerManager) SetInterval(code string, interval time.Duration) error {
+	if interval < m.config.MinInterval {
+		return ErrIntervalBelowMinimum
+	}
+
+	m.mu.Lock()
+	defer m.mu.Unlock()
+
+	tracker := m.find(code)
+	if tracker == nil {
+		return ErrTrackerNotRunning
+	}
+
+	tracker.UpdateInterval(interval)
+	m.save()
+
+	return nil
+}
+
+func (m *TrackerManager) SetNotificationsPaused(code string, paused bool) error {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+
+	tracker := m.find(code)
+	if tracker == nil {
+		return ErrTrackerNotRunning
+	}
+
+	tracker.SetNotificationsPaused(paused)
+	m.save()
+
+	return nil
+}
+
+// Resume starts the trackers that were running before the bot was restarted
+// and lets each affected chat know about the restart.
+func (m *TrackerManager) Resume() {
+	saved, err := readStateFile(m.config.StateFile)
+	if err != nil {
+		log.Printf("[State] Failed to read tracker state from %s: %s", m.config.StateFile, err)
+		return
+	}
+
+	resumedPerChat := m.resume(saved)
+
+	for chatID, codes := range resumedPerChat {
+		slices.Sort(codes)
+		message := fmt.Sprintf("The bot was restarted; resumed %d tracker(s): <b>%s</b>", len(codes), strings.Join(codes, ", "))
+		m.messenger.SendHTML(chatID, message)
+	}
+}
+
+func (m *TrackerManager) resume(saved []savedTracker) map[int64][]string {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+
+	resumedPerChat := make(map[int64][]string)
+
+	for _, s := range saved {
+		if !m.config.IsChatAllowed(s.ChatID) {
+			log.Printf("[State] Not resuming tracker '%s': chat %d is not allowed", s.Code, s.ChatID)
+			continue
+		}
+
+		interval, err := time.ParseDuration(s.Interval)
+		if err != nil {
+			log.Printf("[State] Not resuming tracker '%s': invalid interval '%s'", s.Code, s.Interval)
+			continue
+		}
+
+		if err := m.start(s.Code, interval, s.ChatID, s.NotificationsPaused); err != nil {
+			if !errors.Is(err, ErrTrackerAlreadyRunning) {
+				log.Printf("[State] Not resuming tracker '%s': %s", s.Code, err)
+			}
+
+			continue
+		}
+
+		resumedPerChat[s.ChatID] = append(resumedPerChat[s.ChatID], s.Code)
+		log.Printf("[State] Resumed tracker '%s' for chat %d with interval %s", s.Code, s.ChatID, interval)
+	}
+
+	// Drops trackers that could not be resumed (e.g. removed from the configuration)
+	m.save()
+
+	return resumedPerChat
+}
+
+// Callers hold m.mu.
+func (m *TrackerManager) find(code string) *Tracker {
+	for _, tracker := range m.running {
+		if tracker.Code == code {
+			return tracker
+		}
+	}
+
+	return nil
+}
+
+// Creates and starts a tracker; an interval of 0 means the configured default. Notifications are paused before the
+// first run, which starts right away. Callers hold m.mu and save afterwards.
+func (m *TrackerManager) start(code string, interval time.Duration, chatID int64, paused bool) error {
+	if m.find(code) != nil {
+		return ErrTrackerAlreadyRunning
+	}
+
+	tracker, err := CreateTracker(m.messenger, code, interval, m.config, chatID)
+	if err != nil {
+		return err
+	}
+
+	tracker.SetNotificationsPaused(paused)
+	m.running = append(m.running, tracker)
+	tracker.Start()
+	log.Printf("[TrackerManager] Started tracker '%s' for chat %d", code, chatID)
+
+	return nil
+}
+
+// Writes the running trackers to the state file. Errors are logged, not returned: failing to persist state
+// should not fail the command that triggered it. Callers hold m.mu.
+func (m *TrackerManager) save() {
+	saved := make([]savedTracker, 0, len(m.running))
+	for _, tracker := range m.running {
+		status := tracker.Status()
+		saved = append(saved, savedTracker{
+			Code:                tracker.Code,
+			ChatID:              tracker.ChatID(),
+			Interval:            status.CurrentInterval.String(),
+			NotificationsPaused: status.NotificationsPaused,
+		})
+	}
+
+	if err := writeStateFile(m.config.StateFile, saved); err != nil {
+		log.Printf("[State] Failed to save tracker state to %s: %s", m.config.StateFile, err)
+	}
+}
